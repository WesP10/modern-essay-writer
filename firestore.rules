rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Essays collection
    match /essays/{essayId} {
      // Users can read their own essays
      allow read: if request.auth != null && request.auth.uid == resource.data.user_id;
      
      // Users can create essays
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
      
      // Users can update their own essays
      allow update: if request.auth != null && request.auth.uid == resource.data.user_id;
      
      // Users can delete their own essays
      allow delete: if request.auth != null && request.auth.uid == resource.data.user_id;
      
      // Essay versions subcollection
      match /versions/{versionId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }
  }
}
